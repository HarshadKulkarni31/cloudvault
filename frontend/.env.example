# Frontend environment variables
# ─────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the values below.
# .env.local is gitignored — NEVER commit real values to Git.
#
# All values come from the SAM deploy output (printed after `sam deploy`).
# ─────────────────────────────────────────────────────────────────────────

# ── API Gateway ───────────────────────────────────────────
# Output: ApiBaseUrl
VITE_API_URL=https://REPLACE_WITH_YOUR_API_GATEWAY_URL/v1

# ── Cognito Authentication ────────────────────────────────
# Output: CognitoHostedUiDomain
# e.g. https://cloudvault-auth.auth.ap-south-1.amazoncognito.com
VITE_COGNITO_DOMAIN=https://REPLACE_WITH_YOUR_COGNITO_DOMAIN

# Output: CognitoClientId
VITE_COGNITO_CLIENT_ID=REPLACE_WITH_YOUR_CLIENT_ID
