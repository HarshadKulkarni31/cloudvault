# Frontend environment variables
# ─────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the value below.
# .env.local is gitignored — NEVER commit real values to Git.
#
# Get VITE_API_URL from the SAM deploy output:
#   ApiBaseUrl = https://<id>.execute-api.<region>.amazonaws.com/v1
# ─────────────────────────────────────────────────────────────────────────

VITE_API_URL=https://REPLACE_WITH_YOUR_API_GATEWAY_URL/v1
